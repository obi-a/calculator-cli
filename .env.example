# Relative directories are resolved against the project directory.
CALCULATOR_LOG_DIR=logs
# Relative files are placed under CALCULATOR_LOG_DIR; absolute paths are also supported.
CALCULATOR_LOG_FILE=calculator.log

# History paths are relative to the project directory unless absolute.
CALCULATOR_HISTORY_FILE=history.csv
CALCULATOR_MAX_HISTORY_SIZE=1000
# Use load explicitly to resume saved history; sessions start empty.
# Auto-save follows calculations, clear, load, undo, and redo.
CALCULATOR_AUTO_SAVE=true

# Limit fractional digits after the existing 28-significant-digit arithmetic.
CALCULATOR_PRECISION=28
# Inclusive maximum absolute operand value for new calculations.
CALCULATOR_MAX_INPUT_VALUE=1e10
CALCULATOR_DEFAULT_ENCODING=utf-8
